projection;
strict ( 2 );
use draft;

define behavior for Z_C_TRAVEL_U alias Travel
use etag
{
  use create;
  use update;
  use delete;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

  use action acceptTravel;
  use action rejectTravel;

  use association _Booking { create; with draft; }
}

define behavior for Z_C_BOOKING_U alias Booking
use etag
{

  use update;
  use delete;

  use association _Travel{ with draft; }
}