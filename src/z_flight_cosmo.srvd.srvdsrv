@EndUserText.label: 'Service Definition for Viewing Flights'
@ObjectModel.leadingEntity.name: 'Z_C_Connection_COSMO'
define service Z_FLIGHT_COSMO {
  expose /DMO/C_Connection_R  as Connection;
  expose /DMO/C_Flight_R      as Flight;
  expose /DMO/I_Carrier_StdVH as Airline;
  expose /DMO/I_Airport_StdVH as Airport;
  expose I_CountryVH          as Country;
}