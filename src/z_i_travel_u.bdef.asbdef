unmanaged implementation in class zbp_i_travel_u unique;
strict ( 2 );
with draft;//1

define behavior for Z_I_TRAVEL_U alias Travel
implementation in class zbp_travel_u unique
draft table zcos_travel_d //2
late numbering//early numbering
lock master total etag LastChangedAt //3
etag master LastChangedAt
authorization master ( global )
{
  create ( authorization : global );
  update ( features : instance );
  delete ( features : instance );

  field ( readonly ) TravelID, LastChangedAt;
  field ( mandatory ) AgencyID, CustomerID, BeginDate, EndDate;

  side effects
  {
    field BookingFee affects field TotalPrice;
  }

  determination calculateTotalPrice
  on modify { field BookingFee; }


  association _Booking
  {
    create; //( features : instance );
    with draft; //4
  }


  // Action definition
  // result [1] $self means the UI will receive the updated record back
  action ( features : instance ) acceptTravel result [1] $self;
  action ( features : instance ) rejectTravel result [1] $self;

  validation validateDates on save
{
  field BeginDate, EndDate;
}

  validation validateCustomer on save
{
  field CustomerID;
}

  draft action Edit;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;

  draft determine action Prepare
  {
      validation validateDates;
      validation validateCustomer;
  }


  mapping for /dmo/travel control /dmo/s_travel_intx
    {
      TravelID      = travel_id;
      AgencyID      = agency_id;
      CustomerID    = customer_id;
      BeginDate     = begin_date;
      EndDate       = end_date;
      LastChangedAt = LastChangedAt;
      CurrencyCode  = currency_code;
      Memo          = description;
      Status        = status;
      TotalPrice    = total_price;
      BookingFee    = booking_fee;
    }

}



define behavior for Z_I_BOOKING_U alias Booking
implementation in class zbp_booking_u unique
draft table zcos_booking_d //5
late numbering //early numbering
lock dependent by _Travel
authorization dependent by _Travel
etag dependent by _Travel
{

  update ;
  delete ;

  field ( readonly ) TravelID, BookingID;
  field ( mandatory ) BookingDate, CustomerID, AirlineID, ConnectionID;

  association _Travel { with draft; } //6

  mapping for /dmo/booking control /dmo/s_booking_intx
    {
      TravelID     = travel_id;
      BookingID    = booking_id;
      BookingDate  = booking_date;
      CustomerID   = customer_id;
      AirlineID    = carrier_id;
      ConnectionID = connection_id;
      FlightDate   = flight_date;
    }
}