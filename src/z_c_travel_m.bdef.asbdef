projection;
strict ( 2 );

define behavior for Z_C_TRAVEL_M //alias <alias_name>
use etag
{
  use create;
  use update;
  use delete;

field ( readonly ) StatusCriticality;

  use association _Booking { create; }
}

define behavior for Z_C_BOOKING_M //alias <alias_name>
use etag
{
  use update;
  use delete;

  use association _Travel;
  use association _BookSupplement { create; }
}

define behavior for Z_C_BOOKINGSUPPL_M //alias <alias_name>
use etag
{
  use update;
  use delete;

  use association _Travel;
  use association _Booking;
}